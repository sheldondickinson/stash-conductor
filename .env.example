# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=replace-with-a-random-secret
ORIGIN=http://localhost:8000
AUTH_MODE=local
# OIDC mode disables local sign-in completely.
# AUTH_MODE=oidc
# ORIGIN=https://stash.example.com
# OIDC_ISSUER=https://auth.example.com/application/o/stash/
# OIDC_CLIENT_ID=stash
# OIDC_CLIENT_SECRET=configure-outside-git
# OIDC_OWNER_GROUP=stash-owners
# OIDC_MEMBER_GROUP=stash-members
# CONDUCTOR_URL=https://conductor.example.com
